# Core
DEBUG=true
SECRET_KEY=change-me-in-production
POSTGRES_DB=conveyor_monitor
POSTGRES_USER=conveyor
POSTGRES_PASSWORD=conveyor
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=conveyor-events
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

# Service URLs
VISION_SERVICE_URL=http://vision-service:8010
PLC_GATEWAY_URL=http://plc-gateway:8020
INTERNAL_SERVICE_TOKEN=dev-internal-token
BACKEND_HOST_PORT=8001
VITE_API_BASE_URL=http://localhost:8001/api
BACKEND_INGEST_URL=http://backend:8000/api/telemetry/ingest/

# Vision source / CV-01 calibration
VISION_VIDEO_SOURCE=/data/conveyor_1.mp4
VISION_LOOP=true
VISION_PUBLISH_HZ=2
VISION_PUSH_INTERVAL_SECONDS=2
VISION_PROCESSING_WIDTH=480
VISION_BELT_WIDTH_MM=1200
VISION_SPEED_SCALE=0.063
VISION_MATERIAL_AREA_EDGE_SCALE=0.158
VISION_ALIGNMENT_ZERO_X=0.500

# Alarm evidence capture
EVIDENCE_CAPTURE_ENABLED=true
EVIDENCE_CAPTURE_TIMEOUT_SECONDS=4
EVIDENCE_URL_TTL_SECONDS=900
EVIDENCE_SECONDS=6
EVIDENCE_FPS=6
EVIDENCE_WIDTH=960
EVIDENCE_JPEG_QUALITY=82

# Conveyor calibration / alarm thresholds
BULK_DENSITY_T_PER_M3=1.32
NOMINAL_CAPACITY_TPH=600
TELEMETRY_STALE_SECONDS=6
ALARM_COOLDOWN_SECONDS=60
ALIGNMENT_WARNING_MM=25
ALIGNMENT_CRITICAL_MM=40
ALIGNMENT_RECOVERY_MM=20
TEAR_WARNING_PROBABILITY=0.35
TEAR_CRITICAL_PROBABILITY=0.65
TEAR_RECOVERY_PROBABILITY=0.25
OVERLOAD_WARNING_PERCENT=80
OVERLOAD_CRITICAL_PERCENT=100
OVERLOAD_RECOVERY_PERCENT=75

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# PLC safety boundary
PLC_WRITE_ENABLED=false
PLC_MODE=SIMULATOR
PLC_ENDPOINT=opc.tcp://plc:4840
PLC_STOP_TAG=Conveyor.CV01.StopRequest
